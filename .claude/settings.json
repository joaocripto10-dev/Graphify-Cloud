{
  "permissions": {
    "deny": [
      "Edit(./data/raw/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Edit(./.claude/agents/**)",
      "Edit(./.claude/skills/**)",
      "Edit(./.claude/hooks/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./.claude/CLAUDE.md)",
      "Edit(./.gitignore)",
      "Edit(./.git/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./**/testar.sh)",
      "Edit(./**/homologar.sh)",
      "Edit(./**/lib_homologacao.sh)",
      "Edit(./**/homologacao.py)",
      "Edit(./**/validar_settings.py)",
      "Edit(./**/homologacao.manifest)",
      "Edit(./tests/fixtures/**)",
      "Edit(./.gitattributes)",
      "Edit(./.claude/commands/**)",
      "Edit(./.mcp.json)",
      "Edit(./.vscode/**)",
      "Bash(git *--output*)",
      "Bash(git diff *--ext-diff*)",
      "Bash(git log *--ext-diff*)",
      "Bash(git show *--ext-diff*)",
      "Bash(git diff *--no-index*)",
      "Bash(git diff *.env*)"
    ],
    "ask": [
      "Bash(python:*)",
      "Bash(py:*)",
      "Bash(powershell:*)",
      "Bash(pwsh:*)",
      "Bash(sh -c:*)",
      "Bash(bash -c:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "PowerShell",
      "Bash(bash scripts/homologar.sh:*)",
      "Bash(python3:*)",
      "Bash(python.exe:*)",
      "Bash(pythonw:*)",
      "Bash(py.exe:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(perl:*)",
      "Bash(ruby:*)",
      "Bash(sh:*)",
      "Bash(source:*)",
      "Bash(eval:*)",
      "Bash(env:*)",
      "Bash(xargs:*)",
      "Bash(cmd:*)",
      "Bash(cmd.exe:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(npm:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(sed:*)",
      "Bash(tee:*)",
      "Bash(rmdir:*)",
      "Bash(ln:*)",
      "Bash(dd:*)",
      "Bash(git add:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git clone:*)",
      "Bash(git switch:*)",
      "Bash(git branch:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git stash:*)",
      "Bash(git config:*)",
      "Bash(git clean:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git apply:*)",
      "Bash(git am:*)",
      "Bash(git worktree:*)",
      "Bash(git init:*)",
      "Bash(git remote:*)",
      "Bash(git submodule:*)",
      "Bash(git update-index:*)",
      "Bash(git tag:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(git -c:*)",
      "Bash(git -C:*)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(graphify query:*)",
      "Bash(graphify explain:*)",
      "Bash(graphify path:*)",
      "Bash(sha256sum:*)",
      "Edit(./.claude/agent-memory-local/**)",
      "Bash(bash scripts/testar.sh motor)",
      "Bash(bash scripts/testar.sh motor-zoneinfo)",
      "Bash(bash scripts/testar.sh governanca)",
      "Bash(bash scripts/testar.sh tudo)",
      "Bash(bash scripts/testar.sh conferir)",
      "Bash(bash scripts/testar.sh demo)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git check-attr *)"
    ],
    "disableAutoMode": "disable",
    "disableBypassPermissionsMode": "disable",
    "blockWritesOutsideWorkingDirectories": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/guarda_agentes.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
