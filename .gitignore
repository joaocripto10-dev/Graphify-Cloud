# Kit de dados: não versionar registros operacionais, segredos ou memória local
.env
.env.*
!.env.example
*.pem
*.key
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
node_modules/
# Pastas de dados existem após o clone (.gitkeep), mas o conteúdo real fica fora do Git
data/raw/*
!data/raw/.gitkeep
data/staging/*
!data/staging/.gitkeep
data/curated/*
!data/curated/.gitkeep
data/analytics/*
!data/analytics/.gitkeep
outputs/*
!outputs/.gitkeep
logs/
*.db
*.sqlite
*.sqlite3
.claude/settings.local.json
.claude/agent-memory-local/
graphify-out/
.graphify_cache/
